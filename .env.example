# GB Retail Backend — copy to .env
# ============================================================
# DATABASE (required)
# Local Node: postgresql://user:pass@localhost:5432/gbretail
# Production (Neon): postgresql://user:pass@neon-host/dbname?sslmode=require
# Edge (Neon HTTP): use Neon pooled URL + USE_NEON=1
# Edge (Prisma Accelerate): prisma://...
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gbretail?schema=public"

# SERVER
PORT=4000
NODE_ENV="development"   # production: "production"

# CORS — comma-separated explicit origins (required with credentials:true; "*" is rejected).
# Include your production frontend URLs, e.g.:
#   CORS_ORIGIN="https://shop1.yourdomain.com,https://shop2.yourdomain.com,https://online.yourdomain.com"
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# EDGE MODE
# Set to 1 when DATABASE_URL is Neon HTTP and deploying to Cloudflare Workers / Vercel Edge.
# Node (default) uses pg TCP — leave USE_NEON=0.
USE_NEON="0"
# WORKER="1"   # Set only in Workers (wrangler.toml [vars] already does). Node must leave unset.

# JWT — REQUIRED in production. Change these from dev defaults before deploying.
JWT_ACCESS_SECRET="change-me-to-a-strong-random-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-to-a-different-strong-random-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# BCRYPT
BCRYPT_ROUNDS="10"

# SEED (optional — for db:seed)
SEED_SUPER_PASSWORD="super123"
SEED_OWNER_PASSWORD="owner123"
SEED_STAFF_PASSWORD="staff123"

# ============================================================
# Production deploy checklist:
# 1. Set DATABASE_URL to your production PostgreSQL/Neon
# 2. Change JWT_ACCESS_SECRET + JWT_REFRESH_SECRET (assertProductionSecrets fails on dev defaults)
# 3. Set CORS_ORIGIN to your production frontend URLs
# 4. Run: npx prisma migrate deploy  (apply migrations)
# 5. Run: npx tsx prisma/seed.ts    (seed 3 shops + owners + products + batches)
# 6. Deploy: wrangler deploy        (Cloudflare Workers) or vercel deploy
# ============================================================
