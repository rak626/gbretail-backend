# Hono Backend — copy to .env
# Local Node: postgresql://...
# Edge (Neon HTTP): use Neon pooled URL + USE_NEON=1
# Edge (Prisma Accelerate): prisma://...
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gbretail?schema=public"
PORT=4000
# Comma-separated explicit origins (required with credentials:true; "*" is rejected).
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
# Set to 1 when DATABASE_URL is Neon HTTP and deploying to Cloudflare Workers / Vercel Edge
USE_NEON="0"
NODE_ENV="development"
# Set WORKER=1 only in Workers (wrangler.toml [vars] already does). Node must leave it unset.
# WORKER="0"
# JWT — REQUIRED in production (assertProductionSecrets throws on dev defaults + missing DATABASE_URL)
JWT_ACCESS_SECRET="dev-access-secret-change-me-32chars"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_ROUNDS="10"
