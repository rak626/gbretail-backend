generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Shop {
  id        String    @id @default(cuid())
  name      String
  address   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  counters  Counter[]
  users     User[]
  products  Product[]
  orders    Order[]
  ledgerEntries LedgerEntry[]

  @@index([name])
  @@index([deletedAt])
}

model Counter {
  id        String    @id @default(cuid())
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  orders    Order[]
  ledgerEntries LedgerEntry[]

  @@unique([shopId, name])
  @@index([shopId])
  @@index([deletedAt])
}

model User {
  id           String    @id @default(cuid())
  shopId       String?
  shop         Shop?     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  email        String    @unique
  passwordHash String
  name         String
  role         String    // SUPER_ADMIN | SHOP_OWNER | STAFF
  // Owner-granted permission: STAFF with this flag can open + edit inventory.
  // SHOP_OWNER always has full access; SUPER_ADMIN never touches shop inventory.
  canManageInventory Boolean @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  orders       Order[]
  ledgerEntries LedgerEntry[]

  @@index([shopId])
  @@index([role])
  @@index([deletedAt])
}

model Product {
  id             String      @id @default(cuid())
  shopId         String?
  shop           Shop?       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name           String
  is_loose       Boolean     @default(false)
  rate_per_kg    Float?
  barcode        String?     @unique
  price          Float?
  costPrice      Float       @default(0)
  unit           String      @default("pcs")
  category       String
  preset_weights Float[]     @default([])
  preset_prices  Float[]     @default([])
  stockQuantity  Float       @default(0)
  lowStockThreshold Float    @default(10)
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]

  @@index([shopId])
  @@index([shopId, category])
  @@index([shopId, name])
  @@index([category])
  @@index([name])
  @@index([deletedAt])
}

model Customer {
  id            String        @id @default(cuid())
  name          String
  phone         String?       @unique
  email         String?
  address       String?
  notes         String?
  creditLimit   Float?
  balance       Float         @default(0)
  totalSpent    Float         @default(0)
  totalOrders   Int           @default(0)
  firstOrderAt  DateTime?
  lastOrderAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orders        Order[]
  ledgerEntries LedgerEntry[]

  @@index([name])
  @@index([phone])
  @@index([deletedAt])
  @@index([lastOrderAt])
  @@index([firstOrderAt])
  @@index([balance])
  @@index([totalSpent])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  shopId        String?
  shop          Shop?         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  counterId     String?
  counter       Counter?      @relation(fields: [counterId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  total         Float
  discount      Float         @default(0)
  paymentMethod String        // "cash" | "upi" | "khata" | "split"
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  status        String        @default("completed")
  orderDate     DateTime      @default(now())
  syncedAt      DateTime?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  ledgerEntries LedgerEntry[]

  @@index([shopId])
  @@index([shopId, createdAt])
  @@index([shopId, counterId])
  @@index([shopId, userId])
  @@index([customerId])
  @@index([createdAt])
  @@index([paymentMethod])
  @@index([orderNumber])
  @@index([deletedAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  price     Float
  unit      String
  quantity  Float?
  weight    Float?
  lineTotal Float
  isCustom  Boolean  @default(false)
  costPrice Float?
  category  String?

  @@index([orderId])
  @@index([productId])
  @@index([category])
}

model LedgerEntry {
  id         String    @id @default(cuid())
  shopId     String?
  shop       Shop?     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  counterId  String?
  counter    Counter?  @relation(fields: [counterId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amount     Float
  creditDays Int       @default(30)
  dueDate    DateTime
  status     String    @default("pending") // pending | settled | overdue (computed)
  note       String?
  settledAt  DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([shopId])
  @@index([shopId, status])
  @@index([shopId, customerId])
  @@index([shopId, dueDate])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
  @@index([settledAt])
  @@index([orderId])
  @@index([deletedAt])
}
