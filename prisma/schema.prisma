generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Shop {
  id        String    @id @default(cuid())
  name      String
  address   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  // Receipt config (per-shop billing identity; NULL falls back to name/""/omitted).
  receiptName   String?
  gstin         String?
  upiId         String?
  phone         String?
  receiptFooter String?
  counters  Counter[]
  users     User[]
  products  Product[]
  orders    Order[]
  ledgerEntries LedgerEntry[]
  customers Customer[]

  @@index([name])
  @@index([deletedAt])
}

model Counter {
  id        String    @id @default(cuid())
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  orders    Order[]
  ledgerEntries LedgerEntry[]
  users     User[]

  @@unique([shopId, name])
  @@index([shopId])
  @@index([deletedAt])
}

model User {
  id           String    @id @default(cuid())
  shopId       String?
  shop         Shop?     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  email        String    @unique
  passwordHash String
  name         String
  role         String    // SUPER_ADMIN | SHOP_OWNER | STAFF
  // Owner-granted permission: STAFF with this flag can open + edit inventory.
  // SHOP_OWNER always has full access; SUPER_ADMIN never touches shop inventory.
  canManageInventory Boolean @default(false)
  // Owner-assigned till: staff bill on this counter (auto-attached at login).
  // Null = unassigned → login falls back to the emptiest active counter.
  counterId String?
  counter   Counter? @relation(fields: [counterId], references: [id], onDelete: SetNull)
  isActive     Boolean   @default(true)
  // Session revocation: embedded in JWTs as `tv`; bump to kill all sessions instantly
  // (password change, deactivate, owner reset, revoke-sessions endpoint).
  tokenVersion Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  orders       Order[]
  ledgerEntries LedgerEntry[]

  @@index([shopId])
  @@index([role])
  @@index([deletedAt])
}

model Product {
  id             String      @id @default(cuid())
  shopId         String?
  shop           Shop?       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name           String
  is_loose       Boolean     @default(false)
  rate_per_kg    Decimal?    @db.Decimal(12, 2)
  barcode        String?     @unique
  price          Decimal?    @db.Decimal(12, 2)
  costPrice      Decimal     @default(0) @db.Decimal(12, 2)
  unit           String      @default("pcs")
  category       String
  preset_weights Float[]     @default([])
  preset_prices  Decimal[]   @default([]) @db.Decimal(12, 2)
  stockQuantity  Float       @default(0)
  lowStockThreshold Float    @default(10)
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]

  @@index([shopId])
  @@index([shopId, category])
  @@index([shopId, name])
  @@index([category])
  @@index([name])
  @@index([deletedAt])
}

model Customer {
  id            String        @id @default(cuid())
  shopId        String
  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  email         String?
  address       String?
  notes         String?
  creditLimit   Decimal?      @db.Decimal(12, 2)
  balance       Decimal       @default(0) @db.Decimal(12, 2)
  totalSpent    Decimal       @default(0) @db.Decimal(12, 2)
  totalOrders   Int           @default(0)
  firstOrderAt  DateTime?
  lastOrderAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orders        Order[]
  ledgerEntries LedgerEntry[]

  @@unique([shopId, phone])
  @@index([shopId])
  @@index([shopId, deletedAt])
  @@index([shopId, balance])
  @@index([name])
  @@index([phone])
  @@index([deletedAt])
  @@index([lastOrderAt])
  @@index([firstOrderAt])
  @@index([balance])
  @@index([totalSpent])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  shopId        String?
  shop          Shop?         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  counterId     String?
  counter       Counter?      @relation(fields: [counterId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  total         Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod String        // "cash" | "upi" | "khata" | "split"
  // Split-tender breakdown (split rows only; NULL for cash/upi/khata).
  // cashAmount + upiAmount == total, enforced server-side.
  cashAmount    Decimal?      @db.Decimal(12, 2)
  upiAmount     Decimal?      @db.Decimal(12, 2)
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  status        String        @default("completed")
  orderDate     DateTime      @default(now())
  syncedAt      DateTime?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  ledgerEntries LedgerEntry[]
  // Client-generated idempotency key (Idempotency-Key header): replays return the
  // original order instead of double-billing. Unique per shop; NULL = legacy rows.
  idempotencyKey         String?
  idempotencyFingerprint String?

  @@index([shopId])
  @@index([shopId, createdAt])
  @@index([shopId, counterId])
  @@index([shopId, userId])
  @@index([customerId])
  @@index([createdAt])
  @@index([paymentMethod])
  @@index([orderNumber])
  @@index([deletedAt])
  @@unique([shopId, idempotencyKey])
  @@index([idempotencyKey])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  price     Decimal   @db.Decimal(12, 2)
  unit      String
  quantity  Float?
  weight    Float?
  lineTotal Decimal   @db.Decimal(12, 2)
  isCustom  Boolean  @default(false)
  costPrice Decimal? @db.Decimal(12, 2)
  category  String?

  @@index([orderId])
  @@index([productId])
  @@index([category])
}

model LedgerEntry {
  id         String    @id @default(cuid())
  shopId     String?
  shop       Shop?     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  counterId  String?
  counter    Counter?  @relation(fields: [counterId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amount     Decimal   @db.Decimal(12, 2)
  creditDays Int       @default(30)
  dueDate    DateTime
  status     String    @default("pending") // pending | settled | overdue (computed)
  note       String?
  settledAt  DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  // Client-generated idempotency key (Idempotency-Key header): replays return the
  // original entry instead of double-posting dues. Unique per shop; NULL = legacy rows.
  idempotencyKey         String?
  idempotencyFingerprint String?

  @@index([shopId])
  @@index([shopId, status])
  @@index([shopId, customerId])
  @@index([shopId, dueDate])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
  @@index([settledAt])
  @@index([orderId])
  @@index([deletedAt])
  @@unique([shopId, idempotencyKey])
  @@index([idempotencyKey])
}
